# Postgres credentials for the myapp-postgres container.
#
# On the server:
#   cp postgres.env.example ~/deploy/myapp/postgres.env
#   # edit the values
#   chmod 600 ~/deploy/myapp/postgres.env
#
# These values seed the database on FIRST RUN ONLY. Changing them after the
# volume has data does NOT rotate the existing user's password.
#
# The matching DATABASE_URL in the app's .env should be:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@myapp-postgres:5432/<POSTGRES_DB>?schema=public

POSTGRES_USER=myapp
POSTGRES_PASSWORD=replace-with-strong-random
POSTGRES_DB=myapp
