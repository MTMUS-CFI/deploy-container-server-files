# Containerfile template — Bun runtime, builds in WSL, runs on RHEL/Podman.
#
# This is the bun counterpart to wsl-npm-deploy-files/Containerfile. Use it for
# projects that:
#   - were developed on Windows/WSL with bun (not npm)
#   - use Postgres only (no Mongo)
#   - are built from a WSL host, not directly on the RHEL server
#
# Substitutions before first build:
#   - The bun major (1.x) line below is pinned to `oven/bun:1-debian`. Bump to a
#     specific version (e.g. `1.1.42-debian`) if you've hit a regression.
#   - Drop or adapt the build-time placeholder envs at the bottom of the build
#     stage to match what the project's modules check at load time.
#   - If the project uses native modules (bcrypt, sharp, etc.) that need a
#     compiler, uncomment the `apt-get install build-essential python3` line.
#   - If the project's package.json `scripts.start` doesn't exist (some bun
#     projects just have `dev` + `build`), change the CMD to whatever serves
#     the production build — typically `["bun", "run", "next", "start"]` for
#     Next.js or `["bun", "run", "./dist/index.js"]` for a built bundle.
#
# Build (from WSL, in the project root):
#   podman build -t localhost/myapp:1.0 -t localhost/myapp:latest .
#
# Ship + load: see REDEPLOY.md.

# -----------------------------------------------------------------------------
# Build stage — install deps, generate Prisma client, build the app.
# -----------------------------------------------------------------------------
FROM docker.io/oven/bun:1-debian AS build
WORKDIR /app
USER root

# Rewrite apt sources to HTTPS in case the build environment blocks plain
# HTTP:80 (corporate firewall, restricted network).
#
# NOTE: unlike node:24-bookworm, oven/bun:1-debian is a slim image with NO CA
# bundle (no ca-certificates package, empty /etc/ssl/certs). Any apt call over
# HTTPS fails certificate verification until ca-certificates is installed —
# see the bootstrap in the runtime stage, and copy it into any apt step you
# add here.
RUN find /etc/apt -name '*.list' -o -name '*.sources' 2>/dev/null \
     | xargs -r sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g'

# Uncomment only if the project has native modules requiring a compiler.
# bcryptjs (pure JS) doesn't need this; bcrypt (native) does. sharp ships
# prebuilt binaries for most platforms but can fall back to compile. bun's
# install behavior tends to surface fewer prebuilt-binary issues than npm.
# RUN apt-get -o Acquire::https::Verify-Peer=false update \
#  && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates \
#  && apt-get install -y --no-install-recommends build-essential python3 \
#  && rm -rf /var/lib/apt/lists/*

# bun supports two lockfile formats — bun.lock (text, default since 1.1.x) and
# bun.lockb (older binary). The wildcard copies whichever the project actually
# has. The * suffix makes it harmless if neither exists, but --frozen-lockfile
# below will then fail loudly (which is what you want).
COPY package.json bun.lock* bun.lockb* ./

# Prisma + a `postinstall` hook: if this project's package.json runs
# `prisma generate` in a postinstall script (common with Prisma), that hook
# fires DURING the `bun install` below and aborts the build with
#   Error: Could not find Prisma Schema that is required for this command.
# because prisma/schema.prisma isn't in the image yet at this layer.
# Uncomment the next line so the schema is present before install.
#
# Leave it commented for non-Prisma projects — COPY of a missing prisma/
# dir would itself error. (Alternative: add --ignore-scripts to the install
# and rely on the explicit `bunx prisma generate` below, but that disables
# EVERY dependency's install scripts, not just Prisma's.)
# COPY prisma ./prisma
RUN bun install --frozen-lockfile

COPY . .

# Build-time placeholder envs. Some frameworks (e.g. Next.js's page-data
# collection) import every route at build time, and any module-level
# `process.env.X` check throws if X is unset — even though the real value
# arrives at runtime via the Quadlet's EnvironmentFile.
#
# List here only the vars that fail the build if absent. The runtime stage
# doesn't inherit these, so no secrets leak into the image.
ENV DATABASE_URL=postgresql://buildtime-placeholder:placeholder@localhost:5432/build?schema=public \
    NEXTAUTH_SECRET=buildtime-placeholder-not-used-at-runtime \
    NEXTAUTH_URL=http://localhost:3000

RUN bunx prisma generate \
 && bun run build


# -----------------------------------------------------------------------------
# Runtime stage — only the built artifacts + curl (for the healthcheck).
# -----------------------------------------------------------------------------
FROM docker.io/oven/bun:1-debian AS runtime
WORKDIR /app
# PORT is the port the app listens on INSIDE its pod — no host port is used.
# If you change it, change EXPOSE below, HealthCmd= in the app Quadlet, and
# Caddy's reverse_proxy to match, and make sure package.json's start script
# doesn't pass -p/--port. See README "Ports".
ENV NODE_ENV=production \
    PORT=3000
USER root

# curl is the only runtime-only OS dep (used by the container's HEALTHCHECK).
# ca-certificates for outbound TLS to whatever external services the app
# talks to. If the app needs anything else at runtime (e.g. fonts for PDF
# rendering, LibreOffice for office-doc conversion), add it to the last
# install line.
#
# CA bootstrap: this image ships no CA bundle, so apt can't verify HTTPS until
# ca-certificates is installed — and it can't install ca-certificates over
# HTTPS without one. The first two apt calls skip TLS peer verification to
# break that loop. This is safe: apt verifies every package against the
# Debian archive's GPG keys (already in the image) regardless of transport —
# the same guarantee Debian's default plain-HTTP mirrors rely on. Everything
# after that runs with normal verification. Without the bootstrap,
# `apt-get update` only WARNS ("certificate verify failed") and the failure
# surfaces later as "Package 'ca-certificates' has no installation candidate".
RUN find /etc/apt -name '*.list' -o -name '*.sources' 2>/dev/null \
     | xargs -r sed -i 's|http://deb.debian.org|https://deb.debian.org|g; s|http://security.debian.org|https://security.debian.org|g' \
 && apt-get -o Acquire::https::Verify-Peer=false update \
 && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# Copy only what runtime needs. Adjust the list based on the project's
# framework. Defaults assume Next.js (App Router, standard build output).
COPY --from=build /app/.next ./.next
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/public ./public
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/package.json ./package.json
# bun lockfile carries through so post-deploy debugging can re-run bun commands
# with the same resolution. If your project uses bun.lockb (binary), the
# wildcard handles either.
COPY --from=build /app/bun.lock* /app/bun.lockb* ./
COPY --from=build /app/next.config.* ./
COPY --from=build /app/tsconfig.json ./tsconfig.json

# Operational scripts (migrations, imports, etc.). Drop or adjust if the
# project doesn't have a scripts/ folder.
COPY --from=build /app/scripts ./scripts

# .env is supplied at runtime via Quadlet `EnvironmentFile=` — never baked in.

EXPOSE 3000

CMD ["bun", "start"]
