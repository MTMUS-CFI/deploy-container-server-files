# App config + secrets. Copy to ~/deploy/myapp/.env on the server, strip the
# surrounding "" quotes from each line (podman --env-file treats them as
# literal characters, unlike systemd EnvironmentFile), and chmod 600.
#
# Generate secrets with:
#   openssl rand -base64 32   # NEXTAUTH_SECRET / opaque tokens
#   openssl rand -hex 32      # FILE_ENCRYPTION_KEY-style 64-hex secrets
#   openssl rand -base64 24   # DB passwords

# ----- Database -----
# In the password segment ONLY, URL-encode any `+` as %2B and `/` as %2F.
# The hostname references the NetworkAlias on the DB pod's Quadlet
# (`myapp-postgres` here — change to match if you renamed it).
DATABASE_URL=postgresql://myapp:CHANGE_ME@myapp-postgres:5432/myapp?schema=public

# ----- Auth (delete this section if the app doesn't use Auth.js v5) -----
# The URL users type: server IP plus this app's site port (README "Ports").
# Switch to https://<hostname> once DNS + TLS are live.
NEXTAUTH_URL=http://<server-ip>:<site-port>
NEXTAUTH_SECRET=CHANGE_ME

# Auth.js v5 rejects requests by default unless this is set when running
# behind a reverse proxy. Caddy is the trusted edge, so opt in.
AUTH_TRUST_HOST=true

# ----- Add app-specific vars below -----
