# MongoDB root credentials for the myapp-mongo container.
#
# On the server:
#   cp mongo.env.example ~/deploy/myapp/mongo.env
#   # edit the values
#   chmod 600 ~/deploy/myapp/mongo.env
#
# These seed the root user on FIRST RUN ONLY (when /data/db is empty).
# Changing them after that does NOT rotate the existing user — to rotate,
# connect as root and run db.changeUserPassword(), or wipe the data dir.
#
# The matching MONGODB_URI in the app's .env should be:
#   mongodb://<MONGO_INITDB_ROOT_USERNAME>:<URL_ENCODED_PASSWORD>@myapp-mongo:27017/<DB_NAME>?authSource=admin
#
# `?authSource=admin` is required because the root user lives in the
# admin database, not in whatever DB you're connecting to. Omitting it
# is the most common cause of "Authentication failed" on first connect.
#
# URL-encode `+` as %2B and `/` as %2F in the password segment ONLY,
# same as the Postgres URL. The matching MONGO_INITDB_ROOT_PASSWORD in
# THIS file stays raw — Mongo stores it verbatim.

MONGO_INITDB_ROOT_USERNAME=myapp
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-random
