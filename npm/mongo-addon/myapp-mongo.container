# Podman Quadlet — MongoDB 7 container (OPTIONAL ADD-ON).
#
# Drop this file into ~/.config/containers/systemd/ ONLY if the app
# needs MongoDB alongside Postgres (typical reason: GridFS file
# storage, or schemaless document collections).
#
# Generated systemd unit:
#   myapp-mongo.service
#
# Lives in the SAME myapp-db-pod as Postgres (myapp-data-net network only).
# The app reaches it as `myapp-mongo:27017` via container DNS. GridFS file
# storage lives at /data/db inside the container.
#
# Data is bind-mounted from a SECOND, dedicated NetApp FlexVol
# `vol_myapp_mongo` (junction `/myapp_mongo`), mounted on the host at
# /netapp/myapp_data/mongo via fstab — see mongo-addon/README.md for
# the provisioning + mount + chown steps. NO `:Z` flag — the NFS mount
# already carries the nfs_t SELinux label and Podman's relabel would
# conflict.
#
# Prerequisite Quadlet edit: the existing myapp-db-pod.pod must carry
# `NetworkAlias=myapp-mongo` in addition to the existing
# `NetworkAlias=myapp-postgres`. aardvark-dns registers pods, not the
# containers inside them, so without the alias the connection string
# `mongodb://...@myapp-mongo:27017/...` won't resolve. See the addon
# README for the one-line edit.

[Unit]
Description=myapp MongoDB 7
Requires=myapp-db-pod-pod.service
After=myapp-db-pod-pod.service

[Container]
Image=docker.io/mongo:7.0
ContainerName=myapp-mongo
Pod=myapp-db-pod.pod

# Run as the mongodb user (UID 999) directly. Same NFS rationale as
# Postgres — see comment in myapp-postgres.container. The bind-mounted
# data dir on NetApp must be pre-chowned to the host UID that maps to
# container 999 (<subuid_base> + 998); see addon README.
User=999:999

# Root credentials seed on FIRST RUN ONLY (when /data/db is empty).
# Changing values after that does NOT rotate the existing user.
EnvironmentFile=%h/deploy/myapp/mongo.env

# Persistent GridFS storage on NetApp NFS. LOSING THIS = total file loss
# (ONTAP snapshots provide point-in-time recovery).
Volume=/netapp/myapp_data/mongo:/data/db

# Health check — mongosh ships with the image. With auth enabled (we set
# MONGO_INITDB_ROOT_USERNAME/PASSWORD in mongo.env), unauthenticated
# mongosh can't perform a full handshake on this version, so the
# healthcheck has to authenticate. Variables come from the container's
# env (loaded via EnvironmentFile=). Avoid shell pipes / parens /
# quotes — Quadlet's HealthCmd= directive passes the value through
# /bin/sh -c (Dash on Debian) and the parser eats those characters.
HealthCmd=mongosh --quiet --host localhost --username $MONGO_INITDB_ROOT_USERNAME --password $MONGO_INITDB_ROOT_PASSWORD --authenticationDatabase admin --eval 1
HealthInterval=10s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=5s

# What to do once the healthcheck has failed HealthRetries times in a
# row. Podman's default (`none`) only labels the container "unhealthy"
# and leaves it running, broken. `kill` stops it so the Restart= policy
# in [Service] brings up a fresh one.
HealthOnFailure=kill

# Don't mark the unit as started until the first healthcheck passes.
# Units ordered After= this one then wait for a service that actually
# answers, not just a container that exists. Requires Podman 5.0+.
#
# With Notify=healthy + HealthOnFailure=kill, a probe that can NEVER pass
# loops forever: start timeout (or kill) → restart → same again, slowed
# only by RestartSteps= backoff. So:
#   - TimeoutStartSec= in [Service] must exceed
#     HealthStartPeriod + HealthRetries × HealthInterval + HealthTimeout,
#     with room to spare for a slow first start.
#   - Never use a freshness-style probe here (e.g. "a job ran in the last
#     hour", "data updated today"). It can't pass on a fresh start, so the
#     unit never finishes starting. Check those from monitoring instead.
Notify=healthy

# Give the database time to shut down cleanly (flush + checkpoint to
# NFS) before Podman escalates to SIGKILL. Podman's default is 10s.
# Passed via PodmanArgs= because the StopTimeout= key is missing from
# older Quadlet versions.
PodmanArgs=--stop-timeout=60

[Service]
Restart=on-failure
RestartSec=5s
# Back off on repeated failures (e.g. a NetApp outage): the delay grows
# from RestartSec= to RestartMaxDelaySec= over RestartSteps= restarts
# instead of retrying every few seconds forever. Requires systemd 254+
# (RHEL 10 ships 257).
#
# StartLimitBurst= / StartLimitIntervalSec= are deliberately left at
# systemd's default (5 starts per 10s). RestartSec= is at least 5s and
# only grows, so automatic restarts can't reach that rate and the limit
# never strands the unit in "failed". Don't set StartLimitBurst=0 or
# StartLimitIntervalSec=0 "to be safe"; it isn't needed and removes the
# guard against a genuinely tight loop.
RestartSteps=6
RestartMaxDelaySec=5min
# Health budget: 30s start period + 5 × 10s retries + 5s timeout ≈ 85s.
TimeoutStartSec=120s
# Must be longer than --stop-timeout above.
TimeoutStopSec=90s

# Resource cap — applied via systemd cgroup. Bump if workload grows.
MemoryMax=1G

[Install]
WantedBy=default.target
